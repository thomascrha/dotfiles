set selection-clipboard clipboard
set recolor "true"
set recolor-darkcolor "#E0E0E0"  # Light grey text
set recolor-lightcolor "#101010" # Very dark grey background
# zathurarc-dark
set smooth_scroll "true"
set scroll-page-aware "true"

# setting recolor-keep true will keep any color your pdf has.
# if it is false, it'll just be black and white
set recolor-keephue             "true"

# Rest of your configs go here:

set browser firefox %s

